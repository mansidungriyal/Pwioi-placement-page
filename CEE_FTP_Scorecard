<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Verify CEE Scorecard — PW Institute of Innovation</title>
<meta name="description" content="Verify the authenticity of a PW Institute of Innovation Common Entrance Exam (CEE) scorecard by entering the student's UEN.">
<style>
  :root{
    --paper:#F5F6F2; --paper-2:#EFF1EC; --ink:#1A1E24; --muted:#666e78;
    --pw-red:#D2232A; --navy:#12233F; --amber:#C98A2B;
    --amber-dim:rgba(201,138,43,0.14); --line:#D7DAD9; --line-strong:#B9BEC2;
  }
  *{box-sizing:border-box;margin:0;padding:0;}
  body{
    font-family:Arial,'Helvetica Neue',sans-serif; color:var(--ink);
    background:#DADCD6; min-height:100vh; padding:40px 16px 80px;
    -webkit-font-smoothing:antialiased;
  }
  .wrap{max-width:820px;margin:0 auto;}

  /* ---- lookup card ---- */
  .lookup{
    background:var(--paper); border:1px solid var(--line-strong);
    box-shadow:0 18px 40px rgba(18,35,63,0.14),0 2px 6px rgba(18,35,63,0.08);
    overflow:hidden; margin-bottom:28px;
  }
  .tint-band{height:8px;width:100%;
    background:repeating-linear-gradient(-45deg,var(--pw-red) 0 3px,var(--navy) 3px 6px,var(--amber) 6px 9px);}
  .lookup-body{padding:40px 48px 44px;}
  .lu-logo img{height:42px;display:block;margin-bottom:26px;}
  .lu-eyebrow{
    font-family:'Courier New',monospace;font-size:11px;letter-spacing:3px;
    text-transform:uppercase;color:var(--pw-red);font-weight:bold;
  }
  .lu-title{
    font-family:Georgia,'Times New Roman',serif;font-weight:bold;
    font-size:26px;color:var(--navy);margin-top:8px;line-height:1.2;
  }
  .lu-sub{font-size:14px;color:var(--muted);margin-top:12px;line-height:1.6;max-width:560px;}
  .lu-form{display:flex;gap:12px;margin-top:26px;flex-wrap:wrap;}
  .lu-form input{
    flex:1;min-width:220px;padding:15px 18px;font-size:15px;
    font-family:'Courier New',monospace;letter-spacing:0.5px;
    border:1.5px solid var(--line-strong);background:#fff;color:var(--ink);
    outline:none;border-radius:2px;
  }
  .lu-form input:focus{border-color:var(--navy);}
  .lu-form button{
    padding:15px 30px;font-size:14px;font-weight:bold;letter-spacing:0.6px;
    text-transform:uppercase;font-family:Arial,sans-serif;
    background:var(--navy);color:#fff;border:none;cursor:pointer;border-radius:2px;
  }
  .lu-form button:hover{background:#0d1a30;}
  .lu-form button:disabled{opacity:0.6;cursor:default;}
  .lu-hint{font-family:'Courier New',monospace;font-size:10px;color:var(--muted);margin-top:12px;letter-spacing:0.4px;}

  .msg{margin-top:20px;font-size:14px;padding:14px 18px;border-radius:2px;display:none;}
  .msg.error{display:block;background:rgba(210,35,42,0.08);border:1px solid var(--pw-red);color:#8a1a1f;}
  .msg.loading{display:block;background:var(--paper-2);border:1px solid var(--line-strong);color:var(--muted);font-family:'Courier New',monospace;font-size:13px;}

  /* ---- rendered scorecard ---- */
  #card{display:none;}
  .sheet{background:var(--paper);border:1px solid var(--line-strong);
    box-shadow:0 18px 40px rgba(18,35,63,0.14),0 2px 6px rgba(18,35,63,0.08);overflow:hidden;}
  header.sc{padding:40px 48px 30px;display:flex;justify-content:space-between;align-items:flex-start;border-bottom:1px solid var(--line);}
  .brand img{height:70px;display:block;}
  .title-block{text-align:right;}
  .title-eyebrow{font-family:'Courier New',monospace;font-size:10.5px;letter-spacing:3px;text-transform:uppercase;color:var(--pw-red);font-weight:bold;}
  .title-main{font-family:Georgia,serif;font-weight:bold;font-size:24px;line-height:1.2;color:var(--navy);margin-top:6px;}

  .verified-chip{
    display:inline-flex;align-items:center;gap:8px;margin:0 48px;margin-top:20px;
    padding:9px 16px;background:rgba(37,120,60,0.10);border:1.5px solid #2e8b4f;border-radius:2px;
  }
  .verified-chip .tick{width:16px;height:16px;flex-shrink:0;}
  .verified-chip span{font-family:'Courier New',monospace;font-size:11.5px;font-weight:bold;letter-spacing:0.5px;color:#1f6b3a;}

  .session-bar{background:#12233F;color:#fff;text-align:center;padding:8px 0;font-family:'Courier New',monospace;font-size:10.5px;letter-spacing:2.5px;text-transform:uppercase;font-weight:bold;}
  .header-center{flex:1;text-align:center;padding:0 20px;}
  .qr-block{text-align:center;}
  .qr-block img{width:74px;height:74px;display:block;}
  .qr-caption{font-family:'Courier New',monospace;font-size:7px;letter-spacing:0.5px;color:var(--muted);margin-top:4px;}
  .candidate-strip{display:flex;flex-wrap:wrap;border-bottom:1px solid var(--line);background:var(--paper-2);}
  .candidate-strip .cand-field{flex:1 1 33.33%;min-width:33.33%;border-bottom:1px solid var(--line);}
  .candidate-strip .cand-field:nth-child(3n){border-right:none;}
  .candidate-strip .cand-field:nth-last-child(-n+3){border-bottom:none;}
  .cand-field{flex:1;padding:20px 26px;border-right:1px solid var(--line);}
  .cand-field:last-child{border-right:none;}
  .cand-label{font-family:'Courier New',monospace;font-size:9px;letter-spacing:1.4px;text-transform:uppercase;color:var(--muted);margin-bottom:7px;}
  .cand-value{font-size:14px;font-weight:bold;}

  .section-block{padding:34px 48px 12px;}
  .panel-title{font-family:'Courier New',monospace;font-size:10.5px;letter-spacing:2.4px;text-transform:uppercase;color:var(--navy);font-weight:bold;margin-bottom:20px;border-bottom:1px solid var(--line-strong);padding-bottom:12px;}
  table{width:100%;border-collapse:collapse;}
  thead th{font-family:'Courier New',monospace;font-size:9.5px;letter-spacing:1.2px;text-transform:uppercase;color:var(--muted);font-weight:bold;text-align:left;padding:0 0 12px;border-bottom:1px solid var(--line-strong);}
  thead th.num{text-align:right;}
  tbody td{padding:17px 0;border-bottom:1px dashed var(--line);font-size:14px;}
  .sub-no{font-family:'Courier New',monospace;font-size:11px;color:var(--pw-red);font-weight:bold;width:38px;}
  .sub-name{font-weight:bold;}
  td.num{text-align:right;font-family:'Courier New',monospace;font-weight:bold;font-size:14px;}
  td.num small{color:var(--muted);font-weight:normal;}
  tbody tr.total-row td{border-bottom:none;border-top:2px solid var(--navy);padding-top:18px;font-size:15px;}
  tr.total-row .sub-name{font-family:Georgia,serif;font-weight:bold;color:var(--navy);}
  tr.total-row td.num{font-size:16px;color:var(--navy);}

  .result-band{margin:28px 48px 0;padding:24px 30px;background:var(--paper-2);border:1px solid var(--line-strong);display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:16px;}
  .overall-label{font-family:'Courier New',monospace;font-size:9.5px;letter-spacing:1.4px;text-transform:uppercase;color:var(--muted);margin-bottom:9px;}
  .overall-value{font-family:Georgia,serif;font-weight:bold;font-size:30px;color:var(--navy);line-height:1;}
  .overall-value span{font-size:15px;font-weight:normal;color:var(--muted);font-family:Arial,sans-serif;}
  .result-seal{display:inline-block;padding:10px 20px;border:2px solid var(--amber);background:var(--amber-dim);}
  .result-seal-text{font-family:'Courier New',monospace;font-size:13px;font-weight:bold;letter-spacing:0.8px;color:#7A5A19;}
  .result-seal-text .dot{display:inline-block;width:9px;height:9px;border-radius:50%;background:var(--amber);margin-right:8px;vertical-align:middle;}

  .ftp-statement{margin:4px 0 20px;padding:18px 22px;background:rgba(201,138,43,0.10);border-left:4px solid var(--amber);font-family:Georgia,serif;font-size:16px;font-weight:bold;color:var(--navy);}
  .card-footer{padding:24px 48px 8px;display:flex;justify-content:space-between;align-items:center;gap:26px;border-top:1px solid var(--line);margin-top:20px;}
  .footer-qr{text-align:center;flex-shrink:0;}
  .footer-qr img{width:70px;height:70px;display:block;}
  .footer-qr .cap{font-family:'Courier New',monospace;font-size:7.5px;letter-spacing:0.5px;color:var(--muted);margin-top:5px;}
  .footer-legal{text-align:right;}
  .footer-legal p{font-family:'Courier New',monospace;font-size:10px;line-height:1.7;color:#444b52;}
  .footer-legal p.strong{color:var(--ink);font-weight:bold;}
  .card-actions{padding:26px 48px 40px;display:flex;gap:12px;justify-content:flex-end;flex-wrap:wrap;}
  .btn{padding:13px 26px;font-size:13px;font-weight:bold;letter-spacing:0.5px;text-transform:uppercase;font-family:Arial,sans-serif;border-radius:2px;cursor:pointer;border:1.5px solid var(--navy);text-decoration:none;display:inline-block;}
  .btn-primary{background:var(--navy);color:#fff;}
  .btn-primary:hover{background:#0d1a30;}
  .btn-ghost{background:transparent;color:var(--navy);}
  .btn-ghost:hover{background:var(--paper-2);}

  @media(max-width:560px){
    .lookup-body,header.sc{padding-left:26px;padding-right:26px;}
    .candidate-strip{flex-direction:column;}
    .cand-field{border-right:none;border-bottom:1px solid var(--line);}
    .result-band,.section-block,.card-actions,.verified-chip{margin-left:0;margin-right:0;}
    .result-band,.card-actions,.section-block{padding-left:26px;padding-right:26px;}
    .title-main{font-size:20px;}
  }
</style>
</head>
<body>
<div class="wrap">

  <!-- ===== LOOKUP ===== -->
  <div class="lookup">
    <div class="tint-band"></div>
    <div class="lookup-body">
      <div class="lu-logo"><img src="data:image/png;base64," alt="PW Institute of Innovation"></div>
      <div class="lu-eyebrow">Scorecard Verification</div>
      <div class="lu-title">Verify a CEE Scorecard</div>
      <div class="lu-sub">Enter the candidate's UEN (Unique Enrollment Number) exactly as printed on the scorecard to view the authentic Common Entrance Exam result issued by PW Institute of Innovation.</div>
      <div class="lu-form">
        <input id="uenInput" type="text" placeholder="e.g. PWIOI_SOT_014006" autocomplete="off" spellcheck="false">
        <button id="verifyBtn" onclick="verify()">Verify</button>
      </div>
      <div class="lu-hint">The UEN is printed in the candidate details section of every scorecard.</div>
      <div id="msg" class="msg"></div>
    </div>
  </div>

  <!-- ===== RESULT ===== -->
  <div id="card">
    <div class="sheet">
      <div class="tint-band"></div>
      <div class="session-bar" id="oSession">Academic Session 2026-2027</div>
      <header class="sc">
        <div class="brand"><img src="data:image/png;base64," alt="PW Institute of Innovation"></div>
        <div class="header-center">
          <div class="title-main">Common Entrance Exam<br>(CEE) Scorecard</div>
        </div>
        <div class="qr-block">
          <img src="data:image/png;base64," alt="Verify QR">
          <div class="qr-caption">SCAN TO VERIFY</div>
        </div>
      </header>

      <div class="candidate-strip">
        <div class="cand-field"><div class="cand-label">Candidate Name</div><div class="cand-value" id="oName">—</div></div>
        <div class="cand-field"><div class="cand-label">Program Name</div><div class="cand-value" id="oProgram">—</div></div>
        <div class="cand-field"><div class="cand-label">UEN</div><div class="cand-value" id="oUen">—</div></div>
        <div class="cand-field"><div class="cand-label">Exam Date</div><div class="cand-value" id="oDate">—</div></div>
        <div class="cand-field"><div class="cand-label">Gender</div><div class="cand-value" id="oGender">—</div></div>
        <div class="cand-field"><div class="cand-label">Channel</div><div class="cand-value" id="oChannel">—</div></div>
      </div>

      <div class="section-block">
        <div class="panel-title">Section-wise marks</div>
        <div class="ftp-statement" id="oFtpStatement" style="display:none;"></div>
        <table>
          <thead><tr><th style="width:38px;"></th><th>Section</th><th class="num">Marks obtained</th></tr></thead>
          <tbody id="oRows"></tbody>
        </table>
      </div>

      <div class="result-band">
        <div>
          <div class="overall-label">Total marks obtained</div>
          <div class="overall-value" id="oTotal">—<span>/200</span></div>
        </div>
        <div class="result-seal"><span class="result-seal-text"><span class="dot"></span><span id="oResult">Qualified</span></span></div>
      </div>

      <footer class="card-footer">
        <div class="footer-qr">
          <img src="data:image/png;base64," alt="Verify QR">
          <div class="cap">VERIFY THE SCORECARD</div>
        </div>
        <div class="footer-legal">
          <p>This Scorecard is valid only for the Academic Year 2026-2027 admission process.</p>
          <p class="strong">This electronically generated scorecard is the official scorecard published by PW IOI.</p>
        </div>
      </footer>

      <div class="card-actions">
        <a class="btn btn-ghost" href="#" onclick="resetView();return false;">Verify another</a>
        <a class="btn btn-primary" id="dlBtn" href="#" onclick="downloadPdf();return false;">Download PDF</a>
      </div>
    </div>
  </div>

</div>

<script>
  // ======================================================================
  const API_URL = "https://script.google.com/macros/s/AKfycbwjTN0EvdprDSECRxRhmOI87_vPbt3Vl7h9I0W1TaUfOEv8XbAD-xMkz32KizDta2u1/exec";
  // ======================================================================

  const $ = function(id){ return document.getElementById(id); };

  function showMsg(text, type){
    var m = $('msg');
    m.className = 'msg ' + type;
    m.textContent = text;
  }
  function clearMsg(){ var m = $('msg'); m.className = 'msg'; m.textContent = ''; }

  function resetView(){
    $('card').style.display = 'none';
    $('uenInput').value = '';
    clearMsg();
    $('uenInput').focus();
    window.scrollTo({ top: 0, behavior: 'smooth' });
  }

  var currentUen = '';

  async function downloadPdf(){
    if(!currentUen){ return; }
    var btn = $('dlBtn');
    var original = btn.textContent;
    btn.textContent = 'Preparing PDF…';
    btn.style.pointerEvents = 'none';
    try{
      var res = await fetch(API_URL + '?uen=' + encodeURIComponent(currentUen) + '&format=pdf');
      var data = await res.json();
      if(!data.ok || !data.pdf){ throw new Error('no pdf'); }
      // decode base64 -> Blob
      var byteChars = atob(data.pdf);
      var byteNums = new Array(byteChars.length);
      for(var i=0;i<byteChars.length;i++){ byteNums[i] = byteChars.charCodeAt(i); }
      var blob = new Blob([new Uint8Array(byteNums)], { type: 'application/pdf' });
      var url = URL.createObjectURL(blob);
      var a = document.createElement('a');
      a.href = url;
      a.download = data.filename || 'Scorecard.pdf';
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      setTimeout(function(){ URL.revokeObjectURL(url); }, 1500);
    }catch(err){
      alert('Could not generate the PDF. Please try again.');
    }finally{
      btn.textContent = original;
      btn.style.pointerEvents = '';
    }
  }

  async function verify(){
    var uen = $('uenInput').value.trim();
    if(!uen){ showMsg('Please enter a UEN.', 'error'); return; }

    $('verifyBtn').disabled = true;
    $('card').style.display = 'none';
    showMsg('Verifying UEN against official records…', 'loading');

    try{
      var res = await fetch(API_URL + '?uen=' + encodeURIComponent(uen));
      var data = await res.json();

      if(!data.ok){
        showMsg(data.error || 'No scorecard found for this UEN.', 'error');
        $('verifyBtn').disabled = false;
        return;
      }

      clearMsg();
      render(data, uen);
      $('verifyBtn').disabled = false;
    }catch(err){
      showMsg('Could not reach the verification service. Please try again.', 'error');
      $('verifyBtn').disabled = false;
    }
  }

  function render(d, uen){
    $('oName').textContent = d.name || '—';
    $('oProgram').textContent = d.program || '—';
    $('oUen').textContent  = d.uen  || uen;
    $('oDate').textContent = d.examDate || '—';
    $('oGender').textContent = d.gender || '—';
    $('oChannel').textContent = d.channel || '—';
    if(d.academicSession){ $('oSession').textContent = 'Academic Session ' + d.academicSession; }
    var titleEl = document.querySelector('#card .title-main');
    if(titleEl && d.channel){
      titleEl.innerHTML = (d.channel === 'FTP' ? 'Fast Track Process<br>(FTP) Scorecard' : 'Common Entrance Exam<br>(CEE) Scorecard');
    }
    var isFtp = (d.channel === 'FTP');

    // panel title + optional FTP statement
    var panelEl = document.querySelector('#card .panel-title');
    if(panelEl){ panelEl.textContent = isFtp ? 'Result' : 'Section-wise marks'; }
    var stmtEl = $('oFtpStatement');
    if(stmtEl){
      if(isFtp && d.ftpStatement){ stmtEl.textContent = d.ftpStatement; stmtEl.style.display = 'block'; }
      else { stmtEl.style.display = 'none'; }
    }

    var body = $('oRows');
    body.innerHTML = '';
    d.sections.forEach(function(s, i){
      var tr = document.createElement('tr');
      tr.innerHTML =
        '<td class="sub-no">' + String(i+1).padStart(2,'0') + '</td>' +
        '<td class="sub-name">' + s.label + '</td>' +
        '<td class="num">' + s.score + '<small> / ' + s.max + '</small></td>';
      body.appendChild(tr);
    });
    if(!isFtp){
      var trt = document.createElement('tr');
      trt.className = 'total-row';
      trt.innerHTML = '<td></td><td class="sub-name">Total</td><td class="num">' + d.total + '<small> / ' + d.max + '</small></td>';
      body.appendChild(trt);
    }

    $('oTotal').innerHTML = d.total + '<span>/' + d.max + '</span>';
    $('oResult').textContent = d.result || 'Qualified';

    currentUen = uen;

    $('card').style.display = 'block';
    $('card').scrollIntoView({ behavior: 'smooth', block: 'start' });
  }

  document.addEventListener('DOMContentLoaded', function(){
    $('uenInput').addEventListener('keydown', function(e){ if(e.key === 'Enter') verify(); });
    var params = new URLSearchParams(window.location.search);
    var pre = params.get('uen');
    if(pre){ $('uenInput').value = pre; verify(); }
  });
</script>
</body>
</html>
